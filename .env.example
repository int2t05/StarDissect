# 环境变量模板 — 复制为 .env 后修改(.env 已被 .gitignore 排除,严禁提交真实密钥)

# LLM(OpenAI 兼容网关时填 base_url;官方 API 则留空 base_url 并用 openai:/anthropic: 前缀模型名)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=glm-5.2

# 深度搜索工具链(agent 的 web_search 降级链:Exa→Tavily→DuckDuckGo;后者无需 key)
TAVILY_API_KEY=
EXA_API_KEY=

# GitHub(真实 star 同步;需 repo 读取权限)
GITHUB_TOKEN=
